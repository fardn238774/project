# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# user-uploaded files (auction sheets, etc.) — kept out of git
/public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Copied from the repo root by scripts/copy-configurator.mjs at dev/build time.
# ~44MB — one source of truth at the root, no duplicate blob in git.
/public/kaido-multicar-garage.html
