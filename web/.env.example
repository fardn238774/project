# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in a real connection string.
#   cp .env.example .env   (or copy on Windows)
# `.env` is gitignored; this `.env.example` is committed as a reference.
# Prisma reads DATABASE_URL via prisma.config.ts (import "dotenv/config").
# ---------------------------------------------------------------------------

# Postgres connection string.
# Recommended host: Neon (https://neon.tech) — serverless Postgres, free tier,
# instant provisioning. Create a project, then copy its connection string here.
#
# Neon gives you a POOLED connection string (use it here for the app) and a
# DIRECT/unpooled one (use it for migrations via DIRECT_URL below).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: direct (non-pooled) connection used for `prisma migrate`.
# Neon/Supabase distinguish pooled vs direct; set this to the unpooled URL.
# Leave commented out if your provider doesn't distinguish them.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js session signing secret. Generate one with:
#   npx auth secret      (or: openssl rand -base64 32)
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Payment gateways — the FR specifies SSLCommerz (primary) and bKash (secondary).
# Without these, checkout refuses with a "not configured" notice rather than
# faking a success. Register for sandbox credentials at:
#   SSLCommerz: https://developer.sslcommerz.com/  (sandbox store)
#   bKash:      https://developer.bka.sh/          (tokenized checkout sandbox)
# ---------------------------------------------------------------------------

# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
# SSLCOMMERZ_SANDBOX="true"          # "false" to hit the live gateway

# BKASH_APP_KEY=""
# BKASH_APP_SECRET=""
# BKASH_USERNAME=""
# BKASH_PASSWORD=""
# BKASH_SANDBOX="true"               # "false" to hit the live gateway

# ---------------------------------------------------------------------------
# AI assistant. Optional: without a key the assistant extracts requirements with
# a deterministic parser instead, and the UI says so. Ranking and reasoning come
# from live inventory either way.
# ---------------------------------------------------------------------------

# ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Google Maps. Optional: powers the "nearest dealer" map on the New Cars detail
# page (and reusable elsewhere). Without it, the dealer address + a keyless
# "Open in Google Maps" link still work; only the embedded map waits on the key.
# Enable the "Maps Embed API" in Google Cloud, then paste the key here. This is
# NEXT_PUBLIC_ because the embed runs in the browser.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
